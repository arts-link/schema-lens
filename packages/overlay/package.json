{
  "name": "@schema-lens/overlay",
  "version": "0.1.0",
  "description": "An isolated browser overlay for inspecting JSON-LD.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arts-link/schema-lens.git",
    "directory": "packages/overlay"
  },
  "bugs": {
    "url": "https://github.com/arts-link/schema-lens/issues"
  },
  "homepage": "https://github.com/arts-link/schema-lens/tree/main/packages/overlay#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "pnpm --filter @schema-lens/core build && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @schema-lens/core build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@schema-lens/core": "workspace:^"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
